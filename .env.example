# Copy to .env and fill in. .env is git-ignored.

# AI provider for the ordering agent: anthropic | openai | openrouter
LLM_PROVIDER=anthropic
# Optional model override. Defaults: anthropic claude-haiku-5-5, openai gpt-5-mini. Required for openrouter.
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Speech (ElevenLabs). Without a key, the mic uses the browser's speech recognition and replies are text only.
ELEVENLABS_API_KEY=
# Optional overrides
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_LANGUAGE=en

# Leave empty to use the embedded database in .data/. Set to use a Postgres server.
DATABASE_URL=

# API server port
PORT=8787
