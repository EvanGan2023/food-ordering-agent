# Copy to .env and fill in. .env is git-ignored.

# AI provider for the ordering agent: anthropic | openai | openrouter
LLM_PROVIDER=anthropic
# Optional model override. Defaults: anthropic claude-haiku-5-5, openai gpt-5-mini. Required for openrouter.
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Demo menu to serve: burger (Patty & Co., default) or bubble-tea (Bramble Tea).
DEMO_MENU=

# Square POS. With a token and location, placed orders go to Square (and show there once paid).
# Start with the Sandbox: developer.squareup.com → your app → Sandbox → Access token and Locations.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# sandbox (default) or production
SQUARE_ENVIRONMENT=sandbox
# square: take the menu from the Square catalog instead of DEMO_MENU
MENU_SOURCE=

# Speech (ElevenLabs). Without a key, the mic uses the browser's speech recognition and replies are text only.
ELEVENLABS_API_KEY=
# Optional overrides
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_LANGUAGE=en

# Free, local voice for spoken replies (no account): set TTS_PROVIDER=kokoro.
# Runs Kokoro (open source) on this server's CPU; the ~90 MB model downloads on first start.
# Takes priority over ElevenLabs for speaking; ElevenLabs still does listening if its key is set.
TTS_PROVIDER=
# Voices: af_heart, af_bella, af_nicole, am_michael, bf_emma, bf_isabella, bm_george, bm_lewis, ...
KOKORO_VOICE=af_heart
# q8 (fast, default) or fp32 (slightly better, slower)
KOKORO_DTYPE=q8
KOKORO_SPEED=1

# Database. Leave empty to use the embedded database in .data/ (local testing).
# For a real restaurant use Supabase: Project → Connect → "Session pooler" connection string.
# Tables are created on first start. See README → "Database: Supabase".
DATABASE_URL=
# Supabase's CA certificate (Project settings → Database → SSL → Download), so the connection is verified.
DATABASE_SSL_CA=
# Connections the server keeps open (default 5; Supabase's free plan has a small limit).
DATABASE_POOL_MAX=

# API server port
PORT=8787
